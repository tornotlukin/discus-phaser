{
  "name": "discus-game",
  "version": "0.1.0",
  "description": "DISCUS - Fast-paced multiplayer disc combat game",
  "main": "dist/server/index.js",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon --watch src/server --watch src/shared --ext ts --exec \"npx tsx src/server/index.ts\"",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "validate:config": "node scripts/validate-config.js"
  },
  "keywords": [
    "game",
    "multiplayer",
    "phaser",
    "colyseus",
    "typescript"
  ],
  "author": "Your Studio",
  "license": "MIT",
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "colyseus": "^0.15.0",
    "colyseus.js": "^0.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "phaser": "^4.0.0-rc.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/ui": "^1.0.0",
    "ajv": "^8.12.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.55.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-html": "^3.2.0",
    "vitest": "^1.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  }
}
